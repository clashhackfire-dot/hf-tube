<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Faded background app-icon collage. Swap the src for a real collage
         drawable/image later; this is a low-alpha placeholder tile for now. -->
    <ImageView
        android:id="@+id/bg_collage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.06"
        android:scaleType="centerCrop"
        android:src="@android:drawable/sym_def_app_icon"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/top_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            app:tabIndicatorColor="@color/accent"
            app:tabSelectedTextColor="@color/text_primary"
            app:tabTextColor="@color/text_secondary"
            app:tabMode="scrollable"
            app:tabGravity="start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp">

            <TextView
                android:id="@+id/wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginBottom="28dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <LinearLayout
                    android:id="@+id/search_pill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_search_pill"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_download_arrow"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />

                    <ImageView
                        android:id="@+id/search_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_search_button"
                        android:padding="10dp"
                        android:src="@drawable/ic_search_small"
                        android:contentDescription="@string/tab_search" />

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
