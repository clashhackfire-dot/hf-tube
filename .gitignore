# --- Captured session data: NEVER commit these, no exceptions ---
*.cookie
*.cookies
*cookie*.txt
*cookie*.json
**/cookies/
**/session/
**/*sessiondata*
app/src/main/assets/cookies*

# --- Signing: only the base64-encoded keystore text is committed
# (keystore/release-keystore.jks.base64). The decoded binary .jks is a
# local build artifact regenerated from that text — never commit it.
app/keystore.jks
*.jks
!keystore/*.jks.base64

# --- Android / Gradle ---
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
*.apk
*.aab
*.ap_
*.dex

# --- Chaquopy / Python ---
app/build/
**/__pycache__/
*.pyc

# --- Termux / misc ---
*.log
